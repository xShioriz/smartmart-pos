# คัดลอกเป็น .env แล้วกรอกเอง — ห้าม commit .env

# Neon: pooled URL (แอป) และ direct URL (prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Session (สุ่มอย่างน้อย 32 ตัวอักษร เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=""

# รหัสผ่านผู้ใช้ตั้งต้นสำหรับ seed
SEED_ADMIN_PASSWORD=""
SEED_CASHIER_PASSWORD=""

# Payment (PromptPay QR) — เริ่มด้วย sandbox เสมอ
PAYMENT_ENV="sandbox"          # sandbox | production
PAYMENT_PROVIDER="opn"         # ยืนยันหลัง Provider Spike
PAYMENT_SANDBOX_PUBLIC_KEY=""
PAYMENT_SANDBOX_SECRET_KEY=""
PAYMENT_LIVE_PUBLIC_KEY=""
PAYMENT_LIVE_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""      # ถ้า Provider ใช้ signature
