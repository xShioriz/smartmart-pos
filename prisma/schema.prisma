// SmartMart POS — schema v2.1 (Full Features + PromptPay QR)
// กฎ: ห้ามแก้ stockQty / remainingQty / points ตรง ๆ นอก server/services (stock, loyalty)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (ใช้ตอนรันแอป)
  directUrl = env("DIRECT_URL")   // direct (ใช้ตอน migrate)
}

enum Role {
  ADMIN
  CASHIER
}

enum StockMovementType {
  INITIAL
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

enum PaymentMethod {
  CASH
  PROMPTPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentEnv {
  SANDBOX
  PRODUCTION
}

enum SaleStatus {
  PENDING_PAYMENT
  COMPLETED
  PARTIALLY_RETURNED
  FULLY_RETURNED
  CANCELLED
  PAID_NEEDS_REVIEW
}

enum PromotionScope {
  PRODUCT
  CATEGORY
  BILL
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PointType {
  EARN
  REDEEM
  RETURN_ADJUST
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  NEAR_EXPIRY
  EXPIRED
  PAYMENT_REVIEW
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]
  returns        SaleReturn[]
  auditLogs      AuditLog[]
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products   Product[]
  promotions Promotion[]
}

model Product {
  id         String   @id @default(uuid()) @db.Uuid
  sku        String   @unique
  barcode    String?  @unique
  name       String
  categoryId String   @db.Uuid
  costPrice  Decimal  @db.Decimal(12, 2)
  price      Decimal  @db.Decimal(12, 2)
  unit       String   @default("ชิ้น")
  stockQty   Int      @default(0) // cache = SUM(batch.remainingQty)
  minStock   Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  batches        ProductBatch[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  promotions     Promotion[]
  notifications  Notification[]

  @@index([categoryId])
  @@index([name])
  @@index([isActive])
}

model ProductBatch {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @db.Uuid
  batchNo      String
  expiryDate   DateTime? @db.Date // null = ไม่มีวันหมดอายุ (เรียงท้ายสุดใน FEFO)
  receivedAt   DateTime  @default(now())
  costPrice    Decimal   @db.Decimal(12, 2)
  initialQty   Int
  remainingQty Int
  createdAt    DateTime  @default(now())

  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements  StockMovement[]
  saleItemBatches SaleItemBatch[]
  notifications   Notification[]

  @@unique([productId, batchNo])
  @@index([productId, expiryDate])
  @@index([expiryDate])
}

model StockMovement {
  id             String            @id @default(uuid()) @db.Uuid
  productId      String            @db.Uuid
  batchId        String?           @db.Uuid
  type           StockMovementType
  quantityChange Int // บวก = เข้า, ลบ = ออก
  balanceAfter   Int // ยอดรวมของสินค้าหลังเคลื่อนไหว
  note           String?
  saleId         String?           @db.Uuid
  returnId       String?           @db.Uuid
  createdById    String            @db.Uuid
  createdAt      DateTime          @default(now())

  product    Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch      ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sale       Sale?         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleReturn SaleReturn?   @relation(fields: [returnId], references: [id], onDelete: Restrict)
  createdBy  User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([batchId])
  @@index([saleId])
}

model Member {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  phone      String   @unique
  email      String?
  points     Int      @default(0) // cache = SUM(PointTransaction.points)
  totalSpent Decimal  @default(0) @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sales       Sale[]
  pointLedger PointTransaction[]

  @@index([name])
}

model PointTransaction {
  id           String    @id @default(uuid()) @db.Uuid
  memberId     String    @db.Uuid
  saleId       String?   @db.Uuid
  returnId     String?   @db.Uuid
  type         PointType
  points       Int // บวก = ได้, ลบ = ใช้/หัก
  balanceAfter Int
  note         String?
  createdAt    DateTime  @default(now())

  member     Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sale       Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleReturn SaleReturn? @relation(fields: [returnId], references: [id], onDelete: Restrict)

  @@index([memberId, createdAt])
}

model Promotion {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  scope        PromotionScope
  discountType DiscountType
  value        Decimal        @db.Decimal(12, 2) // % หรือ บาท
  productId    String?        @db.Uuid
  categoryId   String?        @db.Uuid
  minPurchase  Decimal?       @db.Decimal(12, 2) // ใช้กับ BILL
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  product   Product?   @relation(fields: [productId], references: [id], onDelete: Restrict)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  saleItems SaleItem[]
  billSales Sale[]     @relation("SaleBillPromotion")

  @@index([isActive, startsAt, endsAt])
}

model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  saleNo         Int           @unique @default(autoincrement())
  receiptNo      String?       @unique // ออกเมื่อ COMPLETED เท่านั้น
  idempotencyKey String        @unique
  cashierId      String        @db.Uuid
  memberId       String?       @db.Uuid
  status         SaleStatus    @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2) // ก่อนส่วนลด
  discountTotal  Decimal       @default(0) @db.Decimal(12, 2) // รวมส่วนลดรายการ + ส่วนลดทั้งบิล
  billDiscount   Decimal       @default(0) @db.Decimal(12, 2) // เฉพาะส่วนลดทั้งบิล (ส่วนหนึ่งของ discountTotal)
  billPromotionId   String?    @db.Uuid
  billPromotionName String?    // snapshot ชื่อโปร ณ ตอนขาย
  total          Decimal       @db.Decimal(12, 2) // subtotal - discountTotal
  paymentMethod  PaymentMethod
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  pointsEarned   Int           @default(0)
  pointsRedeemed Int           @default(0)
  createdAt      DateTime      @default(now())

  cashier           User               @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  member            Member?            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  billPromotion     Promotion?         @relation("SaleBillPromotion", fields: [billPromotionId], references: [id], onDelete: Restrict)
  payment           Payment?
  items             SaleItem[]
  stockMovements    StockMovement[]
  pointTransactions PointTransaction[]
  returns           SaleReturn[]

  @@index([createdAt])
  @@index([cashierId])
  @@index([memberId])
  @@index([status])
  @@index([billPromotionId])
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  saleId           String        @unique @db.Uuid // 1:1 กับ Sale
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  environment      PaymentEnv // บันทึกเสมอ แยก sandbox / production
  provider         String? // null สำหรับเงินสด
  providerChargeId String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("THB")
  qrImageUrl       String?
  expiresAt        DateTime?
  paidAt           DateTime?
  confirmedVia     String? // 'webhook' | 'reconcile'
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  webhookEvents WebhookEvent[]

  @@index([status, expiresAt])
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String    @unique // กัน webhook ซ้ำ
  eventType       String
  paymentId       String?   @db.Uuid
  payload         Json
  outcome         String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
}

model SaleItem {
  id             String  @id @default(uuid()) @db.Uuid
  saleId         String  @db.Uuid
  productId      String  @db.Uuid
  promotionId    String? @db.Uuid
  promotionName  String? // snapshot ชื่อโปรรายการ ณ ตอนขาย
  skuSnapshot    String
  nameSnapshot   String
  unitPrice      Decimal @db.Decimal(12, 2)
  unitCost       Decimal @db.Decimal(12, 2) // ทุนถัวจาก batch ที่ตัดจริง (0 ขณะ PENDING_PAYMENT)
  quantity       Int
  returnedQty    Int     @default(0)
  lineTotal      Decimal @db.Decimal(12, 2) // unitPrice * quantity
  discountAmount Decimal @default(0) @db.Decimal(12, 2) // ส่วนลดรายการ + ส่วนลดบิลที่กระจายมา
  netTotal       Decimal @db.Decimal(12, 2) // lineTotal - discountAmount

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  promotion   Promotion?       @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  batches     SaleItemBatch[]
  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model SaleItemBatch {
  id         String  @id @default(uuid()) @db.Uuid
  saleItemId String  @db.Uuid
  batchId    String  @db.Uuid
  quantity   Int
  restoredQty Int     @default(0) // คืนเข้าล็อตนี้แล้วกี่หน่วย (จากการคืนสินค้า)
  unitCost   Decimal @db.Decimal(12, 2)

  saleItem SaleItem     @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  batch    ProductBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([saleItemId])
  @@index([batchId])
}

model SaleReturn {
  id             String   @id @default(uuid()) @db.Uuid
  returnSeq      Int      @unique @default(autoincrement())
  returnNo       String   @unique
  idempotencyKey String?  @unique // กันกดคืนซ้ำ (สร้างจาก client ต่อ 1 คำขอ)
  saleId         String   @db.Uuid
  reason         String
  refundTotal    Decimal  @db.Decimal(12, 2)
  refundNote     String? // เช่น โอนคืนนอกระบบ (บิล QR)
  pointsReversed Int      @default(0)
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  sale              Sale               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items             SaleReturnItem[]
  stockMovements    StockMovement[]
  pointTransactions PointTransaction[]

  @@index([saleId])
  @@index([createdAt])
}

model SaleReturnItem {
  id           String  @id @default(uuid()) @db.Uuid
  returnId     String  @db.Uuid
  saleItemId   String  @db.Uuid
  quantity     Int
  refundAmount Decimal @db.Decimal(12, 2)
  restock      Boolean @default(true)

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  type      NotificationType
  title     String
  message   String
  productId String?          @db.Uuid
  batchId   String?          @db.Uuid
  dedupeKey String           @unique
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  product Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch   ProductBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
